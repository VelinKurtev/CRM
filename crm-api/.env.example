DATABASE_URL="postgresql://crm:crm@localhost:5433/crm?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7
APP_URL="http://localhost:5173"
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="CRM <no-reply@crm.local>"
RESET_TOKEN_TTL_MINUTES=60

# Optional
NODE_ENV="development"
# SMTP_USER=""
# SMTP_PASS=""
# Credentials of the admin user created by `npm run db:seed`
# SEED_ADMIN_EMAIL="admin@crm.local"
# SEED_ADMIN_PASSWORD="Admin123!"
# Tests use their own database (name must end in _test). Defaults to crm_test on the dev server.
# TEST_DATABASE_URL="postgresql://crm:crm@localhost:5433/crm_test?schema=public"
